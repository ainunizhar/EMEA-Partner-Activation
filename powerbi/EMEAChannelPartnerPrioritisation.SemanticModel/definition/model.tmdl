model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "Partners", "Countries", "PartnerServices", "PartnerDim", "VendorTies"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Partners
ref table Countries
ref table PartnerServices
ref table PartnerDim
ref table VendorTies
