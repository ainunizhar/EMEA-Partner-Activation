	partition Partners = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "emea_partners.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Founded Year", "Employee Range Order", "Gap Count", "Activation Score", "Pts Priority", "Pts Decision Maker", "Pts Gap"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Partner", type text}, {"Country", type text}, {"HQ Location", type text}, {"Description", type text}, {"Industries", type text}, {"Revenue Range", type text}, {"Founded Year", Int64.Type}, {"Company Type", type text}, {"Website", type text}, {"Employee Range", type text}, {"Employee Range Order", Int64.Type}, {"Size Band", type text}, {"Primary Segment", type text}, {"Type Code", type text}, {"Normalised Segment", type text}, {"Segment Confidence", type text}, {"DF", type text}, {"IR", type text}, {"DFIR", type text}, {"MDR/EDR", type text}, {"XDR", type text}, {"SIEM", type text}, {"VA/Pen Test", type text}, {"SOC-as-a-Service", type text}, {"Compromise Assessment", type text}, {"Gap Count", Int64.Type}, {"Gap Services", type text}, {"PAN Tier", type text}, {"CrowdStrike Tier", type text}, {"Elastic Relationship", type text}, {"Sentinel Relationship", type text}, {"CrowdStrike Relationship", type text}, {"Vendor Partnerships", type text}, {"Market Tier", type text}, {"Fit", type text}, {"Priority", type text}, {"Activation Score", type number}, {"Pts Priority", Int64.Type}, {"Pts Decision Maker", Int64.Type}, {"Pts Gap", Int64.Type}, {"Has Decision Maker", type text}, {"Evidence URL", type text}}, "en-US"),

				    WithId = Table.AddIndexColumn(Typed, "Partner ID", 1, 1, Int64.Type),
				    WithKey = Table.AddColumn(WithId, "Partner Key", each Text.Trim(Text.Trim([Partner]) & " | " & (if [Country] = null then "" else Text.Trim([Country]))), type text),
				    TargetFlag = Table.AddColumn(WithKey, "Is Target", each if [Priority] = "Not a Target" then "No" else "Yes", type text),
				    ScoreBand = Table.AddColumn(TargetFlag, "Score Band", each if [Activation Score] = null then null else Number.RoundDown([Activation Score]), Int64.Type),
				    PriorityOrder = Table.AddColumn(ScoreBand, "Priority Order", each List.PositionOf({"High", "Medium", "Low", "Not a Target", "Unscored"}, [Priority]) + 1, Int64.Type)
				in
				    PriorityOrder

	annotation PBI_ResultType = Table
