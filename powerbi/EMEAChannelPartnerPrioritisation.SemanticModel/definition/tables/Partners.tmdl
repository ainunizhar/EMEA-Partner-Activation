table Partners
	lineageTag: 5beae3df-a577-5f3a-a397-2c3c2932e43a

	measure Partners = COUNTROWS ( Partners )
		formatString: #,0
		lineageTag: 95f711fa-0698-5285-a067-b226e6e42502

	measure 'Target Partners' = CALCULATE ( [Partners], Partners[Priority] <> "Not a Target" )
		formatString: #,0
		lineageTag: b4d4a080-42e9-5911-9f8a-ae7ac8da94e1

	measure 'High Priority' = CALCULATE ( [Partners], Partners[Priority] = "High" )
		formatString: #,0
		lineageTag: cb77d258-07ac-5831-a3ce-14f8713ed22a

	measure 'Medium Priority' = CALCULATE ( [Partners], Partners[Priority] = "Medium" )
		formatString: #,0
		lineageTag: bbeca912-6f6d-5450-b001-ce54ef8c9264

	measure 'Not a Target' = CALCULATE ( [Partners], Partners[Priority] = "Not a Target" )
		formatString: #,0
		lineageTag: fc7ae7d1-5a18-5b60-9e09-e7d1fb2f365f

	measure 'Avg Activation Score' = AVERAGE ( Partners[Activation Score] )
		formatString: 0.0
		lineageTag: 87b44676-7aac-515c-95b4-d18bd4a74e3d

	measure 'Decision Maker on File %' = DIVIDE ( CALCULATE ( [Partners], Partners[Has Decision Maker] = "Yes" ), [Partners] )
		formatString: 0%
		lineageTag: 6f25c233-32a2-5a4c-bb61-54db2dde1a81

	measure 'Avg Missing Services' = AVERAGE ( Partners[Gap Count] )
		formatString: 0.0
		lineageTag: 27c84053-4908-5413-a389-3b6adb02787f

	measure Countries = DISTINCTCOUNT ( Partners[Country] )
		formatString: #,0
		lineageTag: ab50b780-60fa-59fd-bead-9e7e8e28ba95

	measure 'Partner Name' = SELECTEDVALUE ( Partners[Partner], "Several partners" )
		lineageTag: 4f680ab3-994b-595a-bb08-951aa0eb739f

	measure 'KPI Sub Partners' = FORMAT ( [Target Partners] + 0, "#,0" ) & " targets   ·   " & FORMAT ( [Not a Target] + 0, "#,0" ) & " not a target"
		lineageTag: cf5fb6ca-caf3-5ae9-bead-52e5ca97bd8d

	measure 'KPI Sub Countries' = VAR top1 = TOPN ( 1, VALUES ( Partners[Country] ), [Partners], DESC ) RETURN "most: " & MAXX ( top1, Partners[Country] ) & " (" & FORMAT ( MAXX ( top1, [Partners] ), "#,0" ) & ")"
		lineageTag: dc022512-e39c-57e6-a251-20471559933e

	measure 'KPI Sub High' = FORMAT ( DIVIDE ( [High Priority], [Partners] ), "0%" ) & " of partners"
		lineageTag: 4b4530d7-623b-50dd-938c-eae953e3c750

	measure 'KPI Sub Score' = "out of 10   ·   " & FORMAT ( CALCULATE ( [Partners], Partners[Activation Score] >= 8 ) + 0, "#,0" ) & " score 8 or more"
		lineageTag: 6c64ef34-5fa1-5d4a-9ab9-d35c3f436dea

	measure 'KPI Sub DM' = "partners with a named contact on file"
		lineageTag: 0e7dfc1a-f876-54fb-bd91-c36c58a8b0d2

