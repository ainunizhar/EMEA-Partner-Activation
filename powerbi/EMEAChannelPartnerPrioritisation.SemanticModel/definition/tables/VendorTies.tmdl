table VendorTies
	lineageTag: 1211ecc2-fa8d-5fd9-8d94-e271cfda4af2

	measure 'Vendor Ties' = COUNTROWS ( VendorTies )
		formatString: #,0
		lineageTag: 3028c0bf-c027-53e3-9c6e-151decf55534

	measure 'Partners With Vendor' = DISTINCTCOUNT ( VendorTies[Partner Key] )
		formatString: #,0
		lineageTag: a9da857a-a1b8-5558-864f-453bfc8249df

	measure Vendors = DISTINCTCOUNT ( VendorTies[Vendor] )
		formatString: #,0
		lineageTag: b93804f0-a999-5db7-b2ca-1e11fe62e0be

	measure 'KPI Sub Ties' = FORMAT ( [Vendors] + 0, "#,0" ) & " vendors   ·   " & FORMAT ( [Partners With Vendor] + 0, "#,0" ) & " partners"
		lineageTag: a98e740f-cb69-51c6-b5bd-2767f8642bb6

	measure 'KPI Sub Vendors' = "Ties per vendor   ·   " & FORMAT ( [Vendors] + 0, "#,0" ) & " vendors named   ·   scroll for all"
		lineageTag: 69677d93-8762-59e6-aef3-77b6ce75fcf3

	column Partner
		dataType: string
		lineageTag: 274b196b-d252-5c29-a3c2-0bfeddbc4f5f
		summarizeBy: none
		sourceColumn: Partner

	column Country
		dataType: string
		lineageTag: 7c552579-5a76-51ac-9d9c-f58ea7fa98fb
		summarizeBy: none
		sourceColumn: Country

	column Vendor
		dataType: string
		lineageTag: 207e2f5b-1135-59f9-a33a-94ff00c97096
		summarizeBy: none
		sourceColumn: Vendor

	column Category
		dataType: string
		lineageTag: 8abc68f1-d9ca-5d2b-879b-599f69e7fbb6
		summarizeBy: none
		sourceColumn: Category

	column Relationship
		dataType: string
		lineageTag: be71b3d5-df36-5cc9-8f0c-589e3198f369
		summarizeBy: none
		sourceColumn: Relationship

	column Confidence
		dataType: string
		lineageTag: 27b20c78-c20d-57ea-b767-35d16361c62a
		summarizeBy: none
		sourceColumn: Confidence

	column 'Evidence URL'
		dataType: string
		lineageTag: 90395f8d-648a-5a60-87e4-3435ab865e5d
		summarizeBy: none
		sourceColumn: Evidence URL

	column 'Partner Key'
		dataType: string
		isHidden
		lineageTag: c06c13e9-8d86-5511-bb58-d05d4db66b60
		summarizeBy: none
		sourceColumn: Partner Key

	partition VendorTies = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "emea_vendor_ties.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Promoted,
				    Typed = Table.TransformColumnTypes(Blanks, {{"Partner", type text}, {"Country", type text}, {"Vendor", type text}, {"Category", type text}, {"Relationship", type text}, {"Confidence", type text}, {"Evidence URL", type text}}, "en-US"),

				    WithKey = Table.AddColumn(Typed, "Partner Key", each Text.Trim(Text.Trim([Partner]) & " | " & (if [Country] = null then "" else Text.Trim([Country]))), type text)
				in
				    WithKey

	annotation PBI_ResultType = Table
