	partition PartnerDim = m
		mode: import
		source =
				let
				    Source = Partners,
				    Keys = Table.Distinct(Table.SelectColumns(Source, {"Partner Key", "Partner", "Country"}), {"Partner Key", Comparer.OrdinalIgnoreCase})   // the engine compares keys case-insensitively
				in
				    Keys

	annotation PBI_ResultType = Table
